# Elastic Beanstalk: React is built during deploy (see scripts/eb_build_frontend.sh).
# Proxy serves /assets from frontend/dist/assets; Django also exposes the same paths via WSGI.
option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: restaurants.wsgi:application
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.micro
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health/
    MatcherHTTPCode: 200-399
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles
    /assets: frontend/dist/assets

commands:
  01_install_nodejs_18_plus:
    command: |
      set -e
      need_install=1
      if command -v node >/dev/null 2>&1; then
        major=$(node -p "process.versions.node.split('.')[0]")
        if [ "$major" -ge 18 ]; then
          need_install=0
        fi
      fi
      if [ "$need_install" -eq 0 ]; then
        exit 0
      fi
      # NodeSource Node 20 (Vite 6 needs Node 18+; AL2 default repos are often too old)
      curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
      if command -v dnf >/dev/null 2>&1; then
        dnf install -y nodejs
      else
        yum install -y nodejs
      fi
    ignoreErrors: false

container_commands:
  00_create_db:
    command: python scripts/create_db.py
    leader_only: true
  01_migrate:
    command: python manage.py migrate --noinput
    leader_only: true
  # Run on every instance so ASG members all get the same frontend/dist (not leader_only).
  02_build_frontend:
    command: bash scripts/eb_build_frontend.sh
  03_collectstatic:
    command: python manage.py collectstatic --noinput
    leader_only: true
