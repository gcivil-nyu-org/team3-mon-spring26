# --- .env.example ---
# Copy this file to .env and fill in the actual values.
# DO NOT commit the .env file to your repository.

# --- ADMIN SECURITY ---
# Secret code required for Admin Portal login
ADMIN_SECURITY_CODE=ADM123

# --- DJANGO CORE SETTINGS ---
DEBUG=True
SECRET_KEY=generate-a-secure-secret-key-for-production
ENVIRONMENT=development

# --- ALLOWED HOSTS ---
# Comma-separated list of domains (e.g. localhost,yourdomain.org)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.org

# --- CSRF TRUSTED ORIGINS ---
# Required for Django 4.0+. Include http:// and https:// variants.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yourdomain.org

# --- DATABASE CONFIGURATION ---
# local dev uses sqlite3, production uses postgresql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# For production PostgreSQL:
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# --- EMAIL SETTINGS ---
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
