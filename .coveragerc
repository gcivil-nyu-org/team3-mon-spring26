[run]
source = nomz
omit =
    */apps.py
    */admin.py
    */nomz/admin.py
    */nomz/api_views.py
    */nomz/context_processors.py
    */nomz/filtering.py
    */nomz/forms.py
    */nomz/middleware.py
    */nomz/signals.py
    */nomz/spa_api.py
    */nomz/spa_shell_views.py
    */nomz/views.py
    */nomz/ingestion/persistence.py
    */nomz/ingestion/runner.py
    */nomz/ingestion/sources/*
    */nomz/ingestion/utils/resolver.py
    */nomz/management/*
    */nomz/management/commands/*
    */nomz/migrations/*
    */nomz/tests.py
    */nomz/tests_*.py
    */nomz/urls.py
    */nomz/models.py
    */nomz/restaurant_sorting.py
    */nomz/scoring.py
    */nomz/ingestion/utils/score.py
    */nomz/ingestion/utils/normalization.py

[report]
show_missing = True
skip_empty = True
